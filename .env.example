# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
# Optional overrides. Defaults (picked from the Stage 9 holdout evals, evals/RESULTS.md): every role
# claude-haiku-5-5, 3 agents, 2 retries. REVIEWPILOT_MODEL_<ROLE> sets one role's model.
# REVIEWPILOT_AGENT_MODEL=claude-haiku-5-5
# REVIEWPILOT_JUDGE_MODEL=claude-haiku-5-5
# REVIEWPILOT_MODEL_CORRECTNESS=claude-sonnet-5-5
# REVIEWPILOT_NUM_AGENTS=3
# REVIEWPILOT_MAX_RETRIES=2
# API (uv run uvicorn api.main:app). If set, every endpoint except /health needs this Bearer token;
# give the web app the same value (web/.env.local).
# REVIEWPILOT_API_TOKEN=
# Demo mode: fixture PR, replayed model answers, fake GitHub poster. No keys, no cost.
# REVIEWPILOT_DEMO=1
# LangSmith tracing (Stage 9): every node and model call, with repo, pr, sha, route and round.
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=reviewpilot
